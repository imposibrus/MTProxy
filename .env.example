# MTProxy Configuration Example
# Copy this file to .env and customize as needed

# ============================================
# Required: Secret for proxy connections
# ============================================
# Generate with: head -c 16 /dev/urandom | xxd -ps
SECRET=cafe1234567890abcdef1234567890ab

# ============================================
# Optional: Proxy tag from @MTProxybot
# ============================================
# Register your proxy at https://t.me/MTProxybot
# PROXY_TAG=

# ============================================
# Optional: External IP (auto-detected if not set)
# ============================================
# Uncomment and set if auto-detection fails
# EXTERNAL_IP=1.2.3.4

# ============================================
# Transport Mode Configuration
# ============================================

# Option 1: EE Mode (Fake-TLS + Padding) - RECOMMENDED
# Provides best obfuscation by mimicking TLS 1.3 traffic
# Uncomment and set a domain that supports TLS 1.3
DOMAIN=www.google.com

# Option 2: DD Mode (Random Padding only)
# Uncomment if you want DD mode WITHOUT Fake-TLS
# (Don't use together with DOMAIN)
# RANDOM_PADDING=true

# Option 3: Standard Mode
# Leave both DOMAIN and RANDOM_PADDING commented/empty

# ============================================
# Advanced Configuration
# ============================================

# Port for client connections (default: 443)
# PORT=443

# Port for statistics endpoint (default: 8888)
# STATS_PORT=8888

# Number of worker processes (default: 1)
# Increase for high-load servers
# WORKERS=2
